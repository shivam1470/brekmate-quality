{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runId",
    "testCommit",
    "environment",
    "startedAt",
    "finishedAt",
    "applicationCommits",
    "dependencyModes",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "testCommit": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1
    },
    "applicationCommits": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencyModes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "real",
          "sandbox",
          "stub",
          "local-real"
        ]
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "outcome",
          "attempt",
          "platform",
          "artifacts"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not-run",
              "quarantined"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
